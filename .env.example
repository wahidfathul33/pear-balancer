# Copy this file to .env (or .env.local) and fill in real values.
# .env* is already gitignored — never commit real credentials.

# --- AI (any OpenAI-compatible chat/completions endpoint) ---------------
# Defaults to OpenRouter (https://openrouter.ai/api/v1) if left unset.
# Point this at any OpenAI-compatible provider instead — e.g.:
#   Groq:      https://api.groq.com/openai/v1
#   Together:  https://api.together.xyz/v1
#   Local LLM: http://localhost:11434/v1 (Ollama, LM Studio, etc.)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Model id understood by whichever AI_BASE_URL you configured.
AI_MODEL=openai/gpt-4o-mini
# Optional attribution headers (only relevant to OpenRouter; safe to leave unset).
AI_SITE_URL=http://localhost:3000
AI_SITE_NAME=Generate Logbook

# --- GitLab (git.uns.ac.id) --------------------------------------------
GITLAB_BASE_URL=https://git.uns.ac.id
# Personal/project access token with `read_api` scope.
GITLAB_TOKEN=
# Optional default: comma-separated project ids or paths (e.g. "123,group/subgroup/repo").
# Used only as a fallback — the logbook page lets you pick repos per-generation
# from a dropdown of your GitLab starred projects, which takes precedence
# when any are selected.
GITLAB_PROJECT_IDS=
# Only commits authored by this email are pulled into the logbook.
GITLAB_AUTHOR_EMAIL=

# --- Logbook generation rules -------------------------------------------
# KETERANGAN_MAP ids to exclude from AI classification (comma-separated).
LOGBOOK_EXCLUDED_IDS=5090
# File diffs with fewer than this many changed (+/-) lines are merged
# together with other small diffs from the same day into one logbook entry.
LOGBOOK_SMALL_CHANGE_THRESHOLD=15
