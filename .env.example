# Copy to .env and fill in real values. .env* is gitignored — never commit secrets.

# AI — any OpenAI-compatible chat/completions endpoint (default: OpenRouter).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-5.6-terra
AI_SITE_URL=http://localhost:3000
AI_SITE_NAME=Generate Logbook
# Set to false only if your model rejects response_format (json_object).
AI_JSON_OBJECT=true

# GitLab — token needs `read_api` scope. Repos are picked per-run in the UI.
GITLAB_BASE_URL=https://git.uns.ac.id
GITLAB_TOKEN=
GITLAB_AUTHOR_EMAIL=

# Logbook rules
LOGBOOK_EXCLUDED_IDS=5090
LOGBOOK_SMALL_CHANGE_THRESHOLD=15
